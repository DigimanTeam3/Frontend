# Copy to .env.local and fill in. Never commit .env.local.
# VITE_* values are embedded in the browser bundle. Do not put secrets here.

# API base path. In production, Vercel rewrites forward /api to the backend.
VITE_API_BASE_URL=/api

# Map tiles come from OpenFreeMap (no API key).

# true: answer API calls with MSW mocks (src/mocks). Use false for real backend and production builds.
VITE_USE_MOCK=true

# Dev only: where the Vite dev server forwards /api (read in vite.config.ts, not bundled).
# Origin only, without /api (the /api path is kept as is).
# Example: http://localhost:8000 or the backend URL in docs/deploy.md
API_PROXY_TARGET=

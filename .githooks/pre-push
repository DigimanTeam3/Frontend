#!/bin/sh
# main 브랜치로 직접 push하지 못하게 막는다. 작업은 브랜치 → PR로 올린다.
# 정말 필요할 때(초기 셋업 등)만: ALLOW_MAIN_PUSH=1 git push ...

[ "$ALLOW_MAIN_PUSH" = "1" ] && exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "main에 직접 push할 수 없습니다. 브랜치를 만들어 PR로 올려 주세요."
    echo "  예: git switch -c feat/s02-home && git push -u origin feat/s02-home"
    exit 1
  fi
done

exit 0
